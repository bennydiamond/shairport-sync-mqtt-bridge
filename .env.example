# --- AirPlay & Audio Settings ---
AIRPLAY_NAME=Garage
ALSA_CARD=0
# Output Device & Mixer Control:
# 1) USB DAC with ALSA softvol (e.g. Woopker X24, Sinilink XY-AP50H):
#    ALSA_OUTPUT_DEVICE=default
#    ALSA_CONTROL=Master
#    USE_HARDWARE_MIXER=false
#    ALSA_VOLUME_CURVE=mapped
# 2) Raspberry Pi 3.5mm onboard audio (bcm2835):
#    ALSA_OUTPUT_DEVICE=hw:0
#    ALSA_CONTROL=PCM
#    USE_HARDWARE_MIXER=false
#    ALSA_VOLUME_CURVE=bcm2835
# 3) PC / x86_64 HDA Intel with hardware Master mixer:
#    ALSA_OUTPUT_DEVICE=plughw:0
#    ALSA_CONTROL=Master
#    USE_HARDWARE_MIXER=auto
#    ALSA_VOLUME_CURVE=mapped
ALSA_OUTPUT_DEVICE=default
ALSA_CONTROL=Master
# auto | true | false
USE_HARDWARE_MIXER=false
# auto | mapped (1:1 alsamixer alignment) | native | bcm2835
ALSA_VOLUME_CURVE=mapped

# --- MQTT & Home Assistant Discovery ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=shairport
MQTT_PASSWORD=shairport
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_TOPIC_PREFIX=garage_audio/
MQTT_DEVICE_PREFIX=alsa_audio
SHAIRPORT_MQTT_TOPIC=garage_audio/shairport

# --- Home Assistant Entity Metadata ---
ENABLE_VOLUME_BRIDGE=true
DEVICE_ID=garage_alsa_audio
FRIENDLY_NAME=Garage ALSA Audio
DEVICE_MANUFACTURER=Raspberry Pi
DEVICE_MODEL=bcm2835 Headphones
VOLUME_SCALE=0_to_100

# --- Optional Remote Syslog (SD Card Protection) ---
SYSLOG_HOST=192.168.0.15
SYSLOG_PORT=514
TZ=America/Toronto
